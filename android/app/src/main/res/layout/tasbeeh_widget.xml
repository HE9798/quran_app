<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tasbeeh_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/tasbeeh_widget_bg"
    android:orientation="vertical">

    <!-- the combo bar: only shown after 1000, half the widget's height -->
    <TextView
        android:id="@+id/tasbeeh_combo"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/tasbeeh_widget_bar_bg"
        android:gravity="center"
        android:includeFontPadding="false"
        android:text="(x1)"
        android:textColor="#12685E"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tasbeeh_count"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:includeFontPadding="false"
        android:text="000"
        android:textColor="#F7EBD4"
        android:textSize="30sp"
        android:textStyle="bold" />
</LinearLayout>
